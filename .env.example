# ---------- Shared ----------
NODE_ENV=development
LOG_LEVEL=debug
# Supabase project (local: `supabase start` values; hosted: project settings)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
# JWT verification: JWKS is derived from SUPABASE_URL; for legacy HS256 projects set SUPABASE_JWT_SECRET
SUPABASE_JWT_SECRET=
# Service role key is ONLY used by migration/seed tooling, never by apps/api or apps/worker
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Database (apps/api + apps/worker) ----------
# API connects as flowza_api (may SET ROLE authenticated); worker as flowza_worker (may SET ROLE flowza_system).
# Use the Supavisor transaction pooler URL in production (port 6543); direct connection locally.
DATABASE_URL_API=postgres://flowza_api:flowza_api@127.0.0.1:54329/flowza
DATABASE_URL_WORKER=postgres://flowza_worker:flowza_worker@127.0.0.1:54329/flowza
# Migration/seed tooling only (superuser locally; postgres role on hosted)
DATABASE_URL_ADMIN=postgres://postgres:postgres@127.0.0.1:54329/flowza
DATABASE_POOL_MAX=10

# ---------- Secrets ----------
# Comma-separated key_id:base64(32 bytes). The first entry is used for new encryptions; others decrypt old data.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLOWZA_CREDENTIALS_MASTER_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# Secret used to sign device push tokens / webhook challenge tokens
FLOWZA_DEVICE_PUSH_SECRET=replace-me

# ---------- API ----------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# Client IP resolution — this value keys the rate limiter and stamps the audit trail, so a spoofable one is a
# rate-limit bypass, not a cosmetic issue. X-Forwarded-For is a chain each proxy APPENDS to, so a client-supplied
# value lands left-most; TRUSTED_PROXY_HOPS counts real proxies in from the right instead (Cloudflare->Fly = 2).
# CLIENT_IP_HEADER names a header the edge rewrites on every request (Cloudflare: cf-connecting-ip) and is preferred
# when set — but it is only trustworthy while the origin refuses traffic that did not arrive through that edge.
TRUST_PROXY=true
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1

# ---------- Worker ----------
WORKER_ID=
WORKER_CONCURRENCY=8
WORKER_QUEUES=sync,processing,reports,notifications,maintenance
WORKER_PER_ORG_CONCURRENCY=5
SCHEDULER_ENABLED=true

# ---------- Email ----------
EMAIL_PROVIDER=console   # console | resend
RESEND_API_KEY=
EMAIL_FROM="FlowZa Time <no-reply@flowza.example>"

# ---------- Web (Vite) ----------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-me
VITE_API_URL=http://localhost:4000
