{
  "name": "@flowza/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'src/**/*.db.test.ts'",
    "test:db": "vitest run --config vitest.db.config.ts",
    "migrate:local": "tsx src/tools/migrate.ts",
    "seed:local": "tsx src/tools/seed.ts",
    "codegen": "tsx src/tools/codegen.ts"
  },
  "dependencies": {
    "@flowza/contracts": "workspace:*",
    "@flowza/shared": "workspace:*",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "zod": "^4.5.4",
    "@flowza/domain": "workspace:*",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.0",
    "@types/luxon": "^3.7.5"
  }
}
